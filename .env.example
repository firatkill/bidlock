APP_ENV=development
DATABASE_URL=postgres://bidlock_app:bidlock_app@localhost:54329/bidlock
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:54329/bidlock_test
DB_POOL_MAX=10
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_SECRET_PREVIOUS=
BOT_TOKEN_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
IP_HASH_SALT=replace-with-a-random-salt
DEMO_MODE=on
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=none
LOG_LEVEL=debug
# Test only: never set in production.
# TEST_API_SECRET=test-secret-change-me
# BOT_SEED_OVERRIDE=42
NEXT_PUBLIC_FEED=polling
NEXT_PUBLIC_POLL_INTERVAL_MS=1000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REPO_URL=https://github.com/firatkill/bidlock
NEXT_TELEMETRY_DISABLED=1
# VERCEL_GIT_COMMIT_SHA is provided by Vercel; local fallback is GIT_SHA, then dev.
