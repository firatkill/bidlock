{
  "name": "bidlock",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "check:guards": "tsx scripts/check-guards.ts",
    "diagram": "mmdc -i src/components/how/state-machine.mmd -o src/components/how/state-machine.svg -b transparent",
    "db:up": "docker compose -f docker/compose.yml up -d db --wait",
    "db:down": "docker compose -f docker/compose.yml down",
    "db:psql": "docker compose -f docker/compose.yml exec db psql -U postgres bidlock",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:reset": "tsx scripts/db/reset.ts --env test",
    "db:env": "tsx scripts/db/apply-env.ts",
    "db:cron": "tsx scripts/db/apply-env.ts supabase-cron",
    "db:tick": "tsx scripts/db/ticker.ts --once",
    "db:ticker": "tsx scripts/db/ticker.ts",
    "test:db": "bash scripts/db/test-db.sh",
    "test:concurrency": "vitest run --config vitest.integration.config.ts",
    "e2e": "node scripts/not-implemented.mjs",
    "test:all": "node scripts/not-implemented.mjs",
    "load:local": "node scripts/not-implemented.mjs",
    "bench:verify": "node scripts/not-implemented.mjs",
    "bench:report": "node scripts/not-implemented.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "shadcn": "3.8.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "type": "module"
}
